{
  "name": "vite-vue-mcp-inspect",
  "version": "1.3.0",
  "license": "MIT",
  "description": "Vite plugin that turns a running Vue app into an MCP server",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "vue",
    "vite",
    "vite-plugin",
    "devtools",
    "ai"
  ],
  "author": "Robonen Andrew <robonenandrew@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/robonen/vite-vue-mcp-inspect.git",
    "directory": "packages/vite-vue-mcp-inspect"
  },
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "scripts": {
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:browser": "vitest run --project browser",
    "typecheck": "tsc --noEmit",
    "build": "tsdown",
    "dev": "tsdown --watch",
    "prepublishOnly": "pnpm build"
  },
  "peerDependencies": {
    "vite": "^7.0.0 || ^8.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@robonen/stdlib": "^0.0.9",
    "@vue/devtools-kit": "^8.1.1",
    "ansis": "^4.2.0",
    "birpc": "^4.0.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "playwright": "^1.52.0",
    "tsdown": "^0.21.7",
    "vite": "^8.0.3",
    "vitest": "^3.2.1"
  }
}
