{
  "name": "vite-vue-mcp-inspect",
  "version": "2.0.0",
  "license": "MIT",
  "description": "Vite plugin that turns a running Vue app into an MCP server",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "vue",
    "vite",
    "vite-plugin",
    "devtools",
    "ai"
  ],
  "author": "Robonen Andrew <robonenandrew@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/robonen/vite-vue-mcp-inspect.git",
    "directory": "packages/vite-vue-mcp-inspect"
  },
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/vite.d.mts",
      "import": "./dist/vite.mjs"
    }
  },
  "module": "./dist/vite.mjs",
  "types": "./dist/vite.d.mts",
  "scripts": {
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:browser": "vitest run --project browser",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.browser.json --noEmit",
    "build": "tsdown",
    "dev": "tsdown --watch",
    "prepublishOnly": "pnpm build"
  },
  "peerDependencies": {
    "vite": "^8.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@robonen/stdlib": "^0.0.12",
    "@vue/devtools-kit": "^8.2.1",
    "ansis": "^4.3.1",
    "birpc": "^4.1.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "playwright": "^1.62.1",
    "tsdown": "^0.22.14",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}
